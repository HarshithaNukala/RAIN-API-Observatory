# Copy to .env and fill in. The .env file is git-ignored; never commit real values.
# One file serves every workspace. Vite only exposes variables prefixed VITE_ to the browser.

# ---------- Server (apps/server: API + worker) ----------
NODE_ENV=development
# Port for the Express API.
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Postgres connection string. For Supabase use the "Session pooler" or direct URI from
# Project Settings -> Database, and keep ?sslmode=require.
# Example shape (placeholder values):
#   postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=
# Optional. Only needed if the project still signs access tokens with the legacy
# shared HS256 secret (Project Settings -> API -> JWT Settings). Leave empty when
# the project uses asymmetric JWT signing keys (verified through JWKS).
SUPABASE_JWT_SECRET=
# Expected "aud" claim of Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops to trust for client IPs (0 locally, 1 behind one proxy).
TRUST_PROXY=0

# Required. Encrypts monitor header values and request bodies at rest (AES-256-GCM).
# A base64-encoded random 32-byte key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up: data encrypted with a lost key cannot be recovered.
ENCRYPTION_KEY=
# Version number of ENCRYPTION_KEY. Increase it when you rotate to a new key.
ENCRYPTION_KEY_VERSION=1
# Retired keys still needed to read existing data, as <version>:<base64 key>, comma-separated.
# Example after one rotation: ENCRYPTION_KEY_VERSION=2 and ENCRYPTION_PREVIOUS_KEYS=1:<old key>
ENCRYPTION_PREVIOUS_KEYS=
# Maximum number of monitors one user can create (1-1000).
MAX_MONITORS_PER_USER=25

# ---------- Web (apps/web) — safe to expose to the browser ----------
VITE_SUPABASE_URL=
# The publishable ("sb_publishable_...") or legacy anon key. NEVER the secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Monitoring worker (npm run dev:worker) ---
# The worker also needs DATABASE_URL and the ENCRYPTION_* keys above (to decrypt request headers).
# Checks running at once per worker process.
WORKER_CONCURRENCY=25
# How often an idle worker looks for due checks.
WORKER_POLL_INTERVAL_MS=1000
# How long a claimed check is leased. At least 45 (longest timeout 30 s + 15 s margin).
WORKER_LEASE_SECONDS=90
# On SIGTERM/SIGINT, how long to wait for in-flight checks before exiting.
WORKER_SHUTDOWN_GRACE_MS=35000
WORKER_DB_MAX_CONNECTIONS=10

# --- Notifications ---
# Email via Resend (https://resend.com). Both are needed; without them email notifications are
# recorded as failed ("not configured"), never as sent. Read by the worker (sending) and the API
# (to tell users whether email works). Keep the key server-side: never prefix it with VITE_.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. RAIN <alerts@your-domain.com>
NOTIFICATION_EMAIL_FROM=
# The public web app URL, for "View incident" links in emails.
APP_BASE_URL=http://localhost:5173
# Notification dispatcher (worker): parallel deliveries, idle poll interval, lease (>= 30 s).
NOTIFY_CONCURRENCY=10
NOTIFY_POLL_INTERVAL_MS=2000
NOTIFY_LEASE_SECONDS=60
